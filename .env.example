# Book2Audio backend environment (copy to .env / set on Render).
# Everything is optional-by-default: with nothing set you get local SQLite,
# local audio files, edge-tts with gTTS fallback, and no external services.

# --- Core ---
JWT_SECRET=change-this-to-a-random-string        # keep stable across deploys
ALLOWED_ORIGINS=http://localhost:3000            # comma-separated frontend origin(s)

# --- TTS ---
TTS_PROVIDER=edge                                # edge | openai | polly
FORCE_EDGE_TTS=true                              # true = edge-tts neural voices (else gTTS fallback)
#EDGE_CHUNK_TIMEOUT=90                           # per-chunk edge-tts timeout (seconds)
#OPENAI_API_KEY=                                 # only if TTS_PROVIDER=openai
#OPENAI_TTS_MODEL=

# --- Persistence (unset = ephemeral local files; see DEPLOYMENT_PERSISTENCE.md) ---
#DATABASE_PATH=./data/book2audio.db              # local SQLite path (when no Turso)
#TURSO_DATABASE_URL=                             # hosted libSQL DB (set both)
#TURSO_AUTH_TOKEN=
#AUDIO_BUCKET=                                   # enables B2/R2 audio storage (S3 API)
#AUDIO_S3_ENDPOINT=                              # e.g. https://s3.<region>.backblazeb2.com
#AUDIO_S3_KEY_ID=
#AUDIO_S3_SECRET_KEY=
#AUDIO_S3_REGION=auto
#AUDIO_PUBLIC_BASE_URL=                          # Cloudflare CDN base in front of the bucket
#AUDIO_OUTPUT_DIR=./output                       # local audio dir override

# --- Optional integrations ---
#PUBLIC_API_URL=                                 # absolute backend URL for podcast feed links
#GEMINI_API_KEY=                                 # LLM summaries (or GOOGLE_AI_API_KEY)
#GEMINI_MODEL=gemini-2.0-flash
#OPENROUTER_API_KEY=                             # second LLM summarizer (after Gemini)
#OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#OCR_SPACE_API_KEY=                              # OCR for scanned PDFs
#FIRECRAWL_API_KEY=                              # paste-URL fallback for JS/bot-protected pages
#SENTRY_DSN=                                     # error monitoring
#HEALTHCHECK_URL=                                # dead-man's-switch ping after daily cleanup

# --- Limits (defaults shown) ---
#MAX_UPLOAD_MB=25
#USER_QUOTA_MB=500
#RATE_LIMIT_UPLOADS_PER_HOUR=30
#RATE_LIMIT_CONVERSIONS_PER_HOUR=10
#MAX_CONVERT_WORDS=20000
#MAX_CONCURRENT_CONVERSIONS=2
#TTS_CONCURRENCY=4
#SESSION_TTL_DAYS=30

# --- Frontend (set in Vercel / shell, not this file) ---
#BACKEND_URL=http://localhost:8000               # Next.js /api/* rewrite target (local/Docker)
#NEXT_PUBLIC_SITE_URL=                           # absolute base for OG social-card images
#NEXT_PUBLIC_UMAMI_ID=                           # Umami analytics website ID
#NEXT_PUBLIC_UMAMI_SRC=                          # only if self-hosting Umami
